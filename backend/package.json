{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "hash-password": "tsx src/cli/hash-password.ts",
    "seed": "tsx --disable-warning=ExperimentalWarning seed/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@jridgewell/trace-mapping": "^0.3.31",
    "hono": "^4.13.18",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
