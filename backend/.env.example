# Copy to backend/.env. Turn on at least one way to sign in (passwords, OIDC,
# GitHub, or several); with none, no one can use the app. Email and Mattermost are
# optional.

# BURNING_PORT=8195
# BURNING_HOST=0.0.0.0
# SQLite file (one server). A postgres:// URL in BURNING_DATABASE_URL wins and
# lets several servers share the data.
# BURNING_DB=data/burning.db
# BURNING_DATABASE_URL=postgres://burning:secret@db.example.com:5432/burning
# The built web app, served on the same port as the API.
# BURNING_STATIC_DIR=../frontend/dist
# Public URL of the web app, for DSNs and links in alerts.
# BURNING_BASE_URL=https://burning.example.com
# Ingest limit for the whole server: events per second and the burst above it.
# BURNING_RATE=50
# BURNING_BURST=500
# Days to keep event payloads; issues and counts are kept.
# BURNING_RETENTION_DAYS=30
# The hour (UTC) daily summary emails go out, to people who turn them on.
# BURNING_DIGEST_HOUR=8
# Emails or group names that are admin on every project.
# BURNING_SITE_ADMINS=you@example.com

# Signs session cookies. Empty means a random secret kept in the database.
# BURNING_SESSION_SECRET=

# Sign-in with an email and password. One account per line:
#   email:scrypt-hash[:group,group]
# Make a hash with: pnpm --filter backend hash-password
# BURNING_PASSWORD_FILE=/etc/burning/passwords

# Sign-in with any OpenID Connect provider; the endpoints come from the
# issuer's discovery document (<issuer>/.well-known/openid-configuration).
# Register this redirect URL with the provider: <web app URL>/auth/callback
# BURNING_OIDC_ISSUER=https://accounts.example.com
# BURNING_OIDC_CLIENT_ID=burning
# BURNING_OIDC_CLIENT_SECRET=
# client_secret_basic, client_secret_post, or none (a public client).
# Empty means basic with a secret, none without.
# BURNING_OIDC_CLIENT_AUTH=
# BURNING_OIDC_REDIRECT_URL=https://burning.example.com/auth/callback
# Drop "groups" for providers that refuse unknown scopes (Google does).
# BURNING_OIDC_SCOPE=openid email profile groups
# BURNING_OIDC_GROUPS_CLAIM=groups
# The button says "Sign in with <name>"; empty means "SSO".
# BURNING_OIDC_NAME=

# Sign-in with GitHub (an OAuth app; GitHub is not OpenID Connect).
# Register this callback URL with the app: <web app URL>/auth/github/callback
# BURNING_GITHUB_CLIENT_ID=
# BURNING_GITHUB_CLIENT_SECRET=
# BURNING_GITHUB_REDIRECT_URL=https://burning.example.com/auth/github/callback
# Who may sign in; at least one is required. * allows anyone with a verified email.
# BURNING_GITHUB_ALLOWED_EMAILS=you@example.com
# BURNING_GITHUB_ORGS=your-org
# GitHub Enterprise Server only:
# BURNING_GITHUB_URL=https://github.example.com
# BURNING_GITHUB_API_URL=https://github.example.com/api/v3

# Email for alerts.
# BURNING_SMTP_HOST=smtp.example.com
# BURNING_SMTP_PORT=587
# BURNING_SMTP_TLS=true
# BURNING_SMTP_USER=
# BURNING_SMTP_PASSWORD=
# BURNING_SMTP_FROM=Burning <burning@example.com>

# Reading code sources (stack frame links). Public repositories need nothing.
# git-credentials lines, one per host, newlines or commas:
# BURNING_GIT_CREDENTIALS=https://x:<token>@github.com
# A private key for ssh clone URLs:
# BURNING_GIT_SSH_KEY=/etc/burning/id_ed25519
# Where git mirrors live; default: a git folder next to the database.
# BURNING_GIT_DIR=

# Burning's own errors, sent with the Sentry SDK to a Burning project (this
# server or another): the backend's, and the web app's. Off when empty.
# BURNING_SENTRY_DSN=https://<key>@burning.example.com/1
# BURNING_SENTRY_WEB_DSN=https://<key>@burning.example.com/2
# BURNING_SENTRY_ENVIRONMENT=production
# The image sets the release (burning@<version>); set it by hand otherwise.
# BURNING_RELEASE=

# A Mattermost bot for direct messages and channel posts.
# BURNING_MATTERMOST_URL=https://mattermost.example.com
# BURNING_MATTERMOST_TOKEN=
