# Copy to backend/.env. Turn on at least one way to sign in (passwords, OIDC,
# or both); with neither, no one can use the app. Email and Mattermost are
# optional.

# BURNING_PORT=8195
# BURNING_DB=data/burning.db
# Public URL of the web app, for DSNs and links in alerts.
# BURNING_BASE_URL=https://burning.example.com
# Ingest limit for the whole server: events per second and the burst above it.
# BURNING_RATE=50
# BURNING_BURST=500
# Days to keep event payloads; issues and counts are kept.
# BURNING_RETENTION_DAYS=30
# Emails or group names that are admin on every project.
# BURNING_SITE_ADMINS=you@example.com

# Signs session cookies. Empty means a random secret kept in the database.
# BURNING_SESSION_SECRET=

# Sign-in with an email and password. One account per line:
#   email:scrypt-hash[:group,group]
# Make a hash with: pnpm --filter backend hash-password
# BURNING_PASSWORD_FILE=/etc/burning/passwords

# Sign-in with any OpenID Connect provider; the endpoints come from the
# issuer's discovery document (<issuer>/.well-known/openid-configuration).
# Register this redirect URL with the provider: <web app URL>/auth/callback
# BURNING_OIDC_ISSUER=https://accounts.example.com
# BURNING_OIDC_CLIENT_ID=burning
# BURNING_OIDC_CLIENT_SECRET=
# client_secret_basic, client_secret_post, or none (a public client).
# Empty means basic with a secret, none without.
# BURNING_OIDC_CLIENT_AUTH=
# BURNING_OIDC_REDIRECT_URL=https://burning.example.com/auth/callback
# Drop "groups" for providers that refuse unknown scopes (Google does).
# BURNING_OIDC_SCOPE=openid email profile groups
# BURNING_OIDC_GROUPS_CLAIM=groups
# The button says "Sign in with <name>"; empty means "SSO".
# BURNING_OIDC_NAME=

# Email for alerts.
# BURNING_SMTP_HOST=smtp.example.com
# BURNING_SMTP_PORT=587
# BURNING_SMTP_TLS=true
# BURNING_SMTP_USER=
# BURNING_SMTP_PASSWORD=
# BURNING_SMTP_FROM=Burning <burning@example.com>

# A Mattermost bot for direct messages and channel posts.
# BURNING_MATTERMOST_URL=https://mattermost.example.com
# BURNING_MATTERMOST_TOKEN=
